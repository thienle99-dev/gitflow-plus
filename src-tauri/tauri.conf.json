{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-docs/main/src/schemas/tauri-conf.schema.json",
  "productName": "GitFlow Desktop",
  "version": "0.2.7",
  "identifier": "com.gitflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @gitflow-desktop/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @gitflow-desktop/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitFlow Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "tray",
        "title": "GitFlow Popover",
        "width": 360,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "fullscreen": false,
        "url": "index.html?window=tray"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
